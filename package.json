{
  "name": "interview-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "npm run validate:content && npm run validate:cpp && npm run validate:python && node --import tsx scripts/generate-manifests.ts",
    "build": "next build --webpack && pagefind --site out",
    "start": "npx serve out",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:content": "node --import tsx scripts/validate-content.ts",
    "validate:cpp": "node --import tsx scripts/validate-cpp-solutions.ts",
    "validate:python": "node --import tsx scripts/validate-python-solutions.ts"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.5",
    "@serwist/next": "^9.5.12",
    "@types/mdx": "^2.0.14",
    "@xyflow/react": "^12.11.6",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "^4.0.1",
    "serwist": "^9.5.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pagefind": "^1.5.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "browserslist": "^4.29.0"
  }
}
